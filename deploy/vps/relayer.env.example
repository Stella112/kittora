# Copy to deploy/vps/relayer.env ON THE SERVER, then `chmod 600 relayer.env`.
# Fill in the secrets there only. Never commit relayer.env or paste its contents anywhere.

CHAIN_ID=137
# Polygon RPC with receipts and logs. drpc's free plan works (log ranges ~100 blocks; the indexer adapts).
POLYGON_RPC_URL=https://polygon.drpc.org
VAULT_ADDRESS=0x2583FE752256afB1F863a2D5EEea5241BD2B4bDb
GROUP_KITTY_ADDRESS=0x19d8687607fD86A25F8e80a535e5A9c6A848A4a7
DEPLOY_BLOCK=96904101
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# --- secrets (fill in on the server) ---
# Relayer hot wallet 0xb6F9…e962: holds POL for gas only.
RELAYER_PRIVATE_KEY=
# Attester 0xa592…8a12 (forfeits NIM SafeLock bonds). Leave empty to disable the watcher.
ATTESTER_PRIVATE_KEY=
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
